includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def TEST_DATA_DIR = System.getenv('TEST_DATA_DIR')

params {
    input_consensusXML = "${projectDir}/test/test-integration-proteinprophet-lfq/input.csv"
    unfiltered_idXML = "${projectDir}/test/test-integration-proteinprophet-lfq/unfiltered_idXML.csv"
    output_dir = System.getenv('NFT_OUTPUT') ?: "${projectDir}/test/output/test-integration-proteinprophet-lfq"
    protein_grouping_algorithm = 'ProteinProphet'
    decoy_database = "${TEST_DATA_DIR}/database/2026-01-12-decoys-Escherichia_coli_str_k_12_substr_mg1655_gca_000005845.ASM584v2.pep.all_contam.fa.fas"
    decoy_string = 'rev_'
    project_name = 'ECOLI_LFQ'
    save_intermediate_files = true
    merge_consensus = true
}

def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))
params.input_consensusXML = csvEnvironmentExpander.prepareInputCsv(params.input_consensusXML, 'test-integration-proteinprophet-lfq-consensus', launchDir)
params.unfiltered_idXML = csvEnvironmentExpander.prepareInputCsv(params.unfiltered_idXML, 'test-integration-proteinprophet-lfq-idXML', launchDir)
methods.setup()
