includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def TEST_DATA_DIR = System.getenv('TEST_DATA_DIR')

params {
    input_consensusXML = "${TEST_DATA_DIR}/ecoli_tmt/ecoli_tmt_IDConflictResolver.consensusXML"
    protein_grouping_algorithm = 'ProteinInferencer'
    protein_quantifier_fractions_aggregate = 'sum'
    project_name = 'ecoli_tmt'
    save_intermediate_files = true
}

if (!TEST_DATA_DIR) {
    throw new Exception('TEST_DATA_DIR is required for the TMT integration test.')
}

methods.setup()

process {
    echo = false
    debug = false
}
