includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def TEST_DATA_DIR = System.getenv('TEST_DATA_DIR')

params {
    input_consensusXML = "${TEST_DATA_DIR}/ecoli_tmt/ecoli_tmt_IDConflictResolver.consensusXML"
    unfiltered_idXML = "${projectDir}/test/test-integration-proteinprophet-tmt/unfiltered_idXML.csv"
    protein_grouping_algorithm = 'ProteinProphet'
    protein_quantifier_fractions_aggregate = 'sum'
    decoy_database = "${TEST_DATA_DIR}/database/2026-01-12-decoys-Escherichia_coli_str_k_12_substr_mg1655_gca_000005845.ASM584v2.pep.all_contam.fa.fas"
    decoy_string = 'rev_'
    project_name = 'ecoli_tmt'
    save_intermediate_files = true
}

if (!TEST_DATA_DIR) {
    throw new Exception('TEST_DATA_DIR is required for the ProteinProphet TMT integration test.')
}

def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))
params.unfiltered_idXML = csvEnvironmentExpander.prepareInputCsv(params.unfiltered_idXML, 'test-integration-proteinprophet-tmt-idXML', launchDir)
methods.setup()

process {
    echo = false
    debug = false
}
