includeConfig "../external/pipeline-Nextflow-config/config/schema/schema.config"
includeConfig "../external/pipeline-Nextflow-config/config/methods/common_methods.config"
includeConfig "../external/pipeline-Nextflow-config/config/resource_handler/resource_handler.config"
includeConfig "../external/pipeline-Nextflow-config/config/store_object_as_json/store_object_as_json.config"

methods {
    set_output_dir = {
        def tz = TimeZone.getTimeZone('UTC')
        def timestamp = new Date().format("yyyyMMdd'T'HHmmss'Z'", tz)
        def software = "OpenMS-${params.openms_version}"
        def root = "${params.output_dir}/${manifest.name}-${manifest.version}/${params.project_name}"
        params.final_output_dir = "${root}/${software}/output"
        params.intermediate_file_dir = "${root}/${software}/intermediate"
        params.log_output_dir = "${root}/log-${manifest.name}-${manifest.version}-${timestamp}/${software}"
        params.process_log_dir = "${params.log_output_dir}/process-log"
        params.pipeline_log_dir = "${params.log_output_dir}/nextflow-log"
        trace.enabled = true
        trace.file = "${params.pipeline_log_dir}/trace.txt"
        timeline.enabled = true
        timeline.file = "${params.pipeline_log_dir}/timeline.html"
        report.enabled = true
        report.file = "${params.pipeline_log_dir}/report.html"
    }

    validate_protein = {
        if (params.containsKey('protein_quantifier_best_charge_and_fraction') ||
                params.containsKey('protein_quantifier_ratios')) {
            throw new Exception('OpenMS 3.6 no longer supports protein_quantifier_best_charge_and_fraction or protein_quantifier_ratios.')
        }
        if (!(params.protein_quantifier_fractions_aggregate in ['sum', 'best'])) {
            throw new Exception('protein_quantifier_fractions_aggregate must be sum or best.')
        }
        if (!(params.protein_grouping_algorithm in ['ProteinProphet', 'ProteinInferencer'])) {
            throw new Exception('protein_grouping_algorithm must be ProteinProphet or ProteinInferencer.')
        }
        if (params.protein_grouping_algorithm == 'ProteinProphet') {
            ['unfiltered_idXML', 'decoy_database', 'decoy_string'].each { key ->
                if (!params.containsKey(key) || !params[key]) {
                    throw new Exception("${key} is required for ProteinProphet.")
                }
            }
        }
        if (params.filter_protein_fdr == true) {
            if (params.protein_grouping_algorithm != 'ProteinInferencer') {
                throw new Exception('filter_protein_fdr is only supported with ProteinInferencer.')
            }
            if (params.containsKey('filter_protein_score_prot') &&
                    params.filter_protein_score_prot != null) {
                throw new Exception('Use protein_fdr_cutoff instead of filter_protein_score_prot when filter_protein_fdr=true.')
            }
            if (params.protein_inference_protein_fdr != true) {
                throw new Exception('filter_protein_fdr requires protein_inference_protein_fdr=true.')
            }
            if (!(params.protein_fdr_cutoff instanceof Number) ||
                    !Double.isFinite(params.protein_fdr_cutoff.toDouble()) ||
                    params.protein_fdr_cutoff < 0 || params.protein_fdr_cutoff >= 1) {
                throw new Exception(
                    'protein_fdr_cutoff must be a finite number from 0 (inclusive) to 1 (exclusive) when filter_protein_fdr=true.'
                )
            }
        }
        if (!params.input_consensusXML?.toString()?.endsWith('.consensusXML')) {
            throw new Exception('input_consensusXML must be one .consensusXML file.')
        }
        if (params.containsKey('unfiltered_idXML') && params.unfiltered_idXML) {
            def lines = new File(params.unfiltered_idXML.toString()).readLines().findAll { it.trim() }
            if (lines.size() < 2 || lines[0].trim() != 'path') {
                throw new Exception('unfiltered_idXML must contain a path header and at least one file path.')
            }
        }
    }

    setup = {
        methods.set_output_dir()
        schema.load_custom_types("${projectDir}/config/custom_schema_types.config")
        schema.validate()
        methods.validate_protein()
        resource_handler.handle_resources("${projectDir}/config/resources.json")
        methods.set_env()
        methods.configure_containerization()
        methods.setup_process_afterscript()
        json_extractor.store_object_as_json(params, new File("${params.pipeline_log_dir}/params.json"))
    }
}
