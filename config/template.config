includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"

params {
    input_consensusXML = '/path/to/cohort.consensusXML'
    unfiltered_idXML = '/path/to/unfiltered_idXML.csv'
    decoy_database = '/path/to/target_decoy.fasta'
    decoy_string = 'DECOY_'
    output_dir = '/path/to/output'
    project_name = 'project'
    protein_grouping_algorithm = 'ProteinProphet'
    protein_quantifier_best_charge = false
    protein_quantifier_fractions_aggregate = 'sum'
    // For ProteinInferencer FDR filtering, set both FDR switches to true and provide protein_fdr_cutoff.
    filter_protein_fdr = false
    protein_inference_protein_fdr = false
    protein_fdr_cutoff = null
    save_intermediate_files = false
    resource_allocation_profile_tag = 'default'
}

methods.setup()
