includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"

params {
    input_consensusXML = '/path/to/consensusXML.csv'
    unfiltered_idXML = '/path/to/unfiltered_idXML.csv'
    decoy_database = '/path/to/target_decoy.fasta'
    decoy_string = 'DECOY_'
    output_dir = '/path/to/output'
    project_name = 'project'
    protein_grouping_algorithm = 'ProteinProphet'
    merge_consensus = true
    save_intermediate_files = false
    resource_allocation_profile_tag = 'default'
}

methods.setup()
